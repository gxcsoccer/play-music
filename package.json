{
  "name": "tingge",
  "version": "0.2.0",
  "description": "AI-friendly CLI for music search, playback, and download",
  "type": "module",
  "license": "MIT",
  "author": "gxcsoccer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gxcsoccer/play-music.git"
  },
  "keywords": [
    "music",
    "cli",
    "player",
    "mpv",
    "ai",
    "claude-code",
    "tui"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "scripts/postinstall.sh",
    "scripts/statusline.sh",
    "README.md"
  ],
  "bin": {
    "play-music": "dist/index.js",
    "ting": "dist/index.js",
    "mu": "dist/index.js"
  },
  "scripts": {
    "postinstall": "bash scripts/postinstall.sh",
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --target node18 --clean",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.2",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.2"
  }
}